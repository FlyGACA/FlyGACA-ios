# macOS
.DS_Store

# Xcode user state / caches
xcuserdata/
*.xcuserstate
DerivedData/

# Generated by XcodeGen / xcodebuild (apple/project.yml is the source)
apple/FlyGACA.xcodeproj/
apple/.build/
apple/FlyGACAKit/.build/

# Firebase per-app config — secrets, downloaded manually from the console
# (docs/RUNBOOK-ios-firebase.md); CI writes an inert placeholder via
# scripts/native/ci-firebase-placeholder.sh. Never commit either.
apple/Apps/*/GoogleService-Info.plist

# Screenshot pipeline output (apple/Scripts)
screenshots/

# Node (only the screenshot renderer uses it)
node_modules/
