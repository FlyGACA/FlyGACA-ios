{
  "name": "flygaca-ios",
  "private": true,
  "version": "0.1.0",
  "description": "Fly GACA native iOS app family — one shared Swift package (FlyGACAKit), one App Store app per study module (PPL, ELPT, AIP, CPL, IR, ATPL)",
  "license": "MIT",
  "scripts": {
    "ios:generate": "bash scripts/native/ios-generate.sh",
    "ios:test": "command -v swift > /dev/null 2>&1 && cd apple/FlyGACAKit && swift test || echo 'Swift not available; skipping iOS tests'",
    "ios:test:watch": "cd apple/FlyGACAKit && swift test --watch",
    "ios:build:ppl": "bash scripts/native/xcodebuild-wrapper.sh ppl debug",
    "ios:build:elpt": "bash scripts/native/xcodebuild-wrapper.sh elpt debug",
    "ios:build:aip": "bash scripts/native/xcodebuild-wrapper.sh aip debug",
    "ios:build:cpl": "bash scripts/native/xcodebuild-wrapper.sh cpl debug",
    "ios:build:ir": "bash scripts/native/xcodebuild-wrapper.sh ir debug",
    "ios:build:atpl": "bash scripts/native/xcodebuild-wrapper.sh atpl debug",
    "ios:build:all": "bash scripts/native/xcodebuild-wrapper.sh all debug",
    "ios:build:release:ppl": "bash scripts/native/xcodebuild-wrapper.sh ppl release",
    "ios:build:release:elpt": "bash scripts/native/xcodebuild-wrapper.sh elpt release",
    "ios:build:release:aip": "bash scripts/native/xcodebuild-wrapper.sh aip release",
    "ios:build:release:cpl": "bash scripts/native/xcodebuild-wrapper.sh cpl release",
    "ios:build:release:ir": "bash scripts/native/xcodebuild-wrapper.sh ir release",
    "ios:build:release:atpl": "bash scripts/native/xcodebuild-wrapper.sh atpl release",
    "ios:build:release:all": "bash scripts/native/xcodebuild-wrapper.sh all release",
    "ios:clean": "rm -rf apple/FlyGACAKit/.build ~/Library/Developer/Xcode/DerivedData/*FlyGACA*",
    "ios:info": "bash scripts/native/xcodebuild-wrapper.sh info",
    "ios:screenshots": "node apple/Scripts/html-render/render.js",
    "firebase:register": "bash scripts/native/firebase-register-apps.sh",
    "sync:content": "bash scripts/sync-content.sh"
  }
}
